<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D"
    android:padding="24dp">

    <!-- Центральный текстовый блок -->
    <LinearLayout
        android:id="@+id/titleContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:letterSpacing="0.12"
            android:text="АЛЕНА ХАРИТОНОВА"
            android:textColor="#9E9E9E"
            android:textSize="16sp" />

        <View
            android:layout_width="100dp"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="18dp"
            android:background="#333333" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:text="ХОДЯЧИЕ\nВ НОЧИ"
            android:textColor="#E0E0E0"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="serif"
            android:text="Жнецы страданий"
            android:textColor="#8D3B3B"
            android:textSize="18sp"
            android:textStyle="italic" />

        <View
            android:layout_width="60dp"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:background="#262626" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:gravity="center"
            android:text="Неофициальный текстовый квест\n(работа фаната по мотивам книги)"
            android:textColor="#757575"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>

</RelativeLayout>